server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to API service. ${API_HOST} is the API hostname (in ACA the
    # internal ingress FQDN; in AKS the in-cluster Service name like `api`).
    # ${API_SCHEME} is `https` for ACA internal ingress and `http` for plain
    # in-cluster Services on AKS.
    location /api/ {
        proxy_pass ${API_SCHEME}://${API_HOST}/api/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;             # streaming
        proxy_read_timeout 600s;
    }

    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
