server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to API service. In Container Apps, ${API_HOST} is the internal FQDN
    # of the api app (set at container start via envsubst). Internal ingress
    # listens on 80/443 — not on the container's targetPort.
    location /api/ {
        proxy_pass https://${API_HOST}/api/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;             # streaming
        proxy_read_timeout 600s;
    }

    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
