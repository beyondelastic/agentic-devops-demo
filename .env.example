# Local development (used by docker-compose.yml).
# In Azure, these come from Bicep / Container Apps env vars + managed identity.

# Foundry (set FOUNDRY_MODE=real and provide endpoint/agent name to call real Foundry locally).
FOUNDRY_MODE=mock
FOUNDRY_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/example
FOUNDRY_AGENT_NAME=clinical-trial-matcher
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Tools service (internal URL the API uses; agent uses the public/internal URL set on the agent).
TOOLS_SERVICE_URL=http://tools:8000

# Demo 6 toggle.
ENABLE_MEMORY_LEAK=false

# App Insights (optional locally).
APPLICATIONINSIGHTS_CONNECTION_STRING=
